# Ref: https://github.com/github/gitignore/blob/main/Objective-C.gitignore

# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/
EasyRead-debug.local.xcconfig

## compatibility with Xcode 8 and earlier (ignoring not required starting Xcode 9)
*.xcscmblueprint
*.xccheckout

## compatibility with Xcode 3 and earlier (ignoring not required starting Xcode 4)
build/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

## Obj-C/Swift specific
*.hmap

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

# CocoaPods
#
# We recommend against adding the Pods directory to your .gitignore. However
# you should judge for yourself, the pros and cons are mentioned at:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
#
# Pods/
#
# Add this line if you want to avoid checking in source code from the Xcode workspace
# *.xcworkspace

# Carthage
#
# Add this line if you want to avoid checking in source code from Carthage dependencies.
# Carthage/Checkouts

Carthage/Build/

# fastlane
#
# It is recommended to not store the screenshots in the git repo.
# Instead, use fastlane to re-generate the screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/#source-control

fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Code Injection
#
# After new code Injection tools there's a generated folder /iOSInjectionProject
# https://github.com/johnno1962/injectionforxcode

iOSInjectionProject/

node_modules/

# .vscode - Visual Studio Code
.vscode/*

# idea
.idea/*

# GitGuardian
.cache_ggshield

# Ref: https://github.com/github/gitignore/blob/4488915eec0b3a45b5c63ead28f286819c0917de/Global/macOS.gitignore
.DS_Store

# macOS Finder custom icon file (contains carriage return in filename, invalid on Windows)
Icon?

.sentryclirc

# Python
__pycache__/
*.py[cod]

# SwiftFormat 
# https://github.com/nicklockwood/SwiftFormat?tab=readme-ov-file#xcode-build-phase
BuildTools/.build
BuildTools/.swiftpm

.tmp/

# Ignore xcodeproj Package.resolved file, use xcworkspace Package.resolved instead (For CocoaPods
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Ignore *.zip, *.app and *.dmg files generated during build or release process
*.zip
*.app
*.dmg

# SwiftPM build artifacts (local EasyReadKit package)
.build/

# Agent goal-session state (transient, not repo governance)
.claude-goal.md

# Local AI tooling and development records are not part of the published project.
/.agents/
/.claude/
/AGENTS.md
/DEVELOPMENT_SPEC.md
/skills-lock.json
/docs/agents/
/docs/exec-plans/
/docs/histories/
/docs/references/
/docs/design-docs/

# Retired upstream documentation and social/release automation, retained locally.
/appcast.xml
/changelog/
/docs/releases/
/docs/assets/star-history/
/scripts/star-history/
/.github/ISSUE_TEMPLATE/
/.github/pull_request_template.md
/.github/workflows/greetings.yml
/.github/workflows/issue-translator.yml
/.github/workflows/star_fork_notification.yml
/.github/workflows/update-star-history.yml
/docs/user-docs/*/GUIDE.md
/docs/user-docs/*/SERVICES.md
/docs/user-docs/*/SPONSOR_LIST.md
/docs/user-docs/*/How-to-translate-Easydict.md
/docs/user-docs/en/EASYREAD_TEST_PLAN.md
/docs/user-docs/en/EASYREAD_UPSTREAM.md
